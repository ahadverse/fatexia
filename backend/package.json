{
  "name": "fatexia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:tracking": "tsx watch src/tracking.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:tracking": "node dist/tracking.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migration:generate": "node scripts/generate-migration.js",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infra/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/infra/database/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/infra/database/data-source.js",
    "geoip:fetch": "node scripts/fetch-geoip.js",
    "seed": "tsx src/infra/database/seed/run-seed.ts",
    "seed:prod": "tsx src/infra/database/seed/prod-bootstrap.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "maxmind": "^5.0.6",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.20",
    "ua-parser-js": "^2.0.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.0.5"
  }
}
