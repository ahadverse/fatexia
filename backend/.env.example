PORT=4000
TRACKING_PORT=4001
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/fatexia

# Open the Postgres connection over TLS. Required by every hosted provider (Neon,
# Supabase, RDS); a local Postgres does not offer it. Defaults to on when
# NODE_ENV=production and off otherwise, so it normally needs no value here.
#
# Set it to true in local dev only when pointing DATABASE_URL at Neon — e.g. to run
# migrations against staging from your laptop. Neon URLs look like:
#   postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/fatexia?sslmode=require
DATABASE_SSL=false

# Backs the Tracker's proxy-detection cache/quota counters (see PLAN-tracker.md Step
# 4/5). If Redis runs in WSL, it's reachable from Windows at localhost by default.
REDIS_URL=redis://localhost:6379

# In production these MUST be set to strong, unique values — the app refuses to boot
# with these dev defaults (or empty) when NODE_ENV=production.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Express `trust proxy` — set behind a reverse proxy / load balancer so req.ip is the
# real client IP. Accepts: false (default), true, a hop count (e.g. 1), or a preset
# (e.g. loopback, 10.0.0.0/8).
#
# In production set the HOP COUNT (1 behind a single nginx/Cloudflare), never `true`.
# With `true`, Express walks the whole X-Forwarded-For chain and takes the left-most
# entry — which is entirely client-supplied. An affiliate could then choose their own
# country and bypass the datacenter/ASN fraud check just by sending a header. req.ip
# feeds the geo lookup, the click row and the fraud score, so this is a real bypass.
TRUST_PROXY=false

# Comma-separated allowlist of browser origins allowed to call the REST API (Admin,
# Affiliate portal, and public-site dev servers). Blank in dev reflects the request
# origin for local convenience; in production this MUST be an explicit list or the
# app refuses to boot.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Public base URL of the Tracker service — only used to compute the shareable offer
# trackingLink DTO field.
PUBLIC_TRACKING_URL=http://localhost:4001

# Directory with MaxMind GeoLite2-City.mmdb / GeoLite2-ASN.mmdb (free MaxMind account
# required: https://www.maxmind.com/en/geolite2/signup). Left empty/missing, geo/ASN
# fields on clicks are just unknown — the tracker still runs.
GEOIP_DB_DIR=data/geoip

# NOTE — the residential-proxy provider keys (IPHub, ipapi.is, IPQS) are deliberately
# NOT environment variables. They are entered in the Admin portal under Integrations
# and read from the `integrations` table at request time.
#
# There is no env fallback on purpose. Two places to put a credential means one of them
# is eventually stale, and the failure is silent in both directions: a key only in .env
# makes the Integrations page look unconfigured while the provider is being billed, and
# a key only in the UI appears not to work if an old env value shadows it.
#
# Rotating a key is a form submission, not a redeploy.

# Only used by seed:prod to bootstrap the first admin account.
SUPERADMIN_EMAIL=admin@fatexia.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Admin
